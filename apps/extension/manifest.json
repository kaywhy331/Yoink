{
  "manifest_version": 3,
  "name": "Yoink Companion",
  "version": "1.22.3",
  "description": "Watches product pages at supported stores and adds one item to your cart when your plan allows. Checkout stays manual.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "notifications",
    "offscreen",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://www.target.com/*",
    "https://trackalacker.com/*",
    "https://www.trackalacker.com/*",
    "https://*.amazon.com/*",
    "https://*.walmart.com/*",
    "https://*.bestbuy.com/*",
    "https://www.disneystore.com/*",
    "https://*.ravensburger.us/*",
    "https://merch.riotgames.com/*",
    "https://*.booksamillion.com/*",
    "https://*.fanatics.com/*",
    "https://*.kohls.com/*",
    "https://*.macys.com/*",
    "https://*.p-bandai.com/*",
    "https://*.pokemoncenter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Yoink Companion",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "inspect-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Open the Yoink handoff that needs you, or inspect the current page"
    }
  }
}
