{
  "name": "yoink",
  "version": "1.16.1",
  "private": true,
  "type": "module",
  "description": "A local-first, signal-driven commerce control plane with Chrome-only execution.",
  "scripts": {
    "dev": "tsx apps/api/src/server.ts",
    "dev:worker": "tsx apps/worker/src/server.ts",
    "build": "npm run build:extension && npm run build:types",
    "build:extension": "esbuild packages/extension-ui/src/popup-state.ts --bundle --format=iife --global-name=YoinkPopupStateModule --platform=browser --target=chrome120 --legal-comments=none --outfile=apps/extension/popup-state.js && esbuild apps/extension/src/target-shadow.ts --bundle --format=iife --global-name=YoinkTargetShadowModule --platform=browser --target=chrome120 --legal-comments=none --outfile=apps/extension/target-shadow.js && esbuild apps/extension/src/target-action.ts --bundle --format=iife --global-name=YoinkTargetActionModule --platform=browser --target=chrome120 --legal-comments=none --outfile=apps/extension/target-action.js && esbuild apps/extension/src/retailer-shadow.ts --bundle --format=iife --global-name=YoinkRetailerShadowModule --platform=browser --target=chrome120 --legal-comments=none --outfile=apps/extension/retailer-shadow.js && esbuild apps/extension/src/observer-recipe-oracle.ts --bundle --format=iife --global-name=YoinkObserverRecipeOracleModule --platform=browser --target=chrome120 --legal-comments=none --outfile=apps/extension/observer-recipe-oracle.js && esbuild apps/extension/src/walmart-action.ts --bundle --format=iife --global-name=YoinkWalmartActionModule --platform=browser --target=chrome120 --legal-comments=none --outfile=apps/extension/walmart-action.js && esbuild apps/extension/src/amazon-action.ts --bundle --format=iife --global-name=YoinkAmazonActionModule --platform=browser --target=chrome120 --legal-comments=none --outfile=apps/extension/amazon-action.js && esbuild apps/extension/src/bestbuy-action.ts --bundle --format=iife --global-name=YoinkBestBuyActionModule --platform=browser --target=chrome120 --legal-comments=none --outfile=apps/extension/bestbuy-action.js && esbuild apps/extension/src/trackalacker-sync.ts --bundle --format=iife --global-name=YoinkTrackalackerSyncModule --platform=browser --target=chrome120 --legal-comments=none --outfile=apps/extension/trackalacker-sync.js",
    "build:types": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/api/src/server.js",
    "start:worker": "node dist/apps/worker/src/server.js",
    "check": "node --stack-size=4096 node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "test:postgres:native": "node --import tsx --test test/postgres-native.test.ts",
    "verify": "npm run check && npm run build && npm test",
    "package:extension": "npm run build:extension && node scripts/package-extension.mjs",
    "package:extension:production": "npm run build:extension && node scripts/package-extension.mjs --profile=production",
    "recipe-trust": "tsx scripts/observer-recipe-trust.ts",
    "portability": "npm run build:types && node scripts/portability.mjs",
    "postgres:cutover": "npm run build:types && node scripts/postgres-cutover.mjs",
    "postgres:roles": "npm run build:types && node scripts/postgres-runtime-roles.mjs",
    "postgres:sessions": "npm run build:types && node scripts/postgres-tenant-session.mjs",
    "postgres:writes": "npm run build:types && node scripts/postgres-tenant-queue-writes.mjs",
    "postgres:worker-control": "npm run build:types && node scripts/postgres-worker-control.mjs",
    "postgres:notification-recovery": "npm run build:types && node scripts/postgres-notification-recovery.mjs",
    "postgres:execution-recovery": "npm run build:types && node scripts/postgres-execution-recovery.mjs",
    "postgres:operational-retention": "npm run build:types && node scripts/postgres-operational-retention.mjs",
    "postgres:observer-candidates": "npm run build:types && node scripts/postgres-observer-candidate-evaluation.mjs",
    "postgres:alert-dispatch": "npm run build:types && node scripts/postgres-operator-alert-connector-dispatch.mjs",
    "postgres:alert-reconciliation": "npm run build:types && node scripts/postgres-operator-alert-reconciliation.mjs",
    "postgres:witness-refresh": "npm run build:types && node scripts/postgres-observer-witness-refresh.mjs",
    "postgres:delivery-lease-recovery": "npm run build:types && node scripts/postgres-hosted-delivery-lease-recovery.mjs",
    "postgres:signal-catalog-apply": "npm run build:types && node scripts/postgres-signal-catalog-apply.mjs",
    "postgres:signal-resolution-apply": "npm run build:types && node scripts/postgres-signal-resolution-apply.mjs",
    "postgres:signal-source-reference-refresh": "npm run build:types && node scripts/postgres-signal-source-reference-refresh.mjs",
    "postgres:signal-terminal-decision-apply": "npm run build:types && node scripts/postgres-signal-terminal-decision-apply.mjs",
    "postgres:signal-offer-incident-apply": "npm run build:types && node scripts/postgres-signal-offer-incident-apply.mjs",
    "postgres:signal-post-incident-decision-apply": "npm run build:types && node scripts/postgres-signal-post-incident-decision-apply.mjs",
    "postgres:signal-mission-binding-apply": "npm run build:types && node scripts/postgres-signal-mission-binding-apply.mjs",
    "postgres:signal-strategy-evaluation-apply": "npm run build:types && node scripts/postgres-signal-strategy-evaluation-apply.mjs",
    "postgres:signal-writer-lock-protocol": "npm run build:types && node scripts/postgres-signal-writer-lock-protocol.mjs",
    "postgres:signal-constraint-config-apply": "npm run build:types && node scripts/postgres-signal-constraint-config-apply.mjs",
    "postgres:signal-action-spend-apply": "npm run build:types && node scripts/postgres-signal-action-spend-apply.mjs",
    "postgres:signal-target-qualification-apply": "npm run build:types && node scripts/postgres-signal-target-qualification-apply.mjs",
    "postgres:signal-source-trust-apply": "npm run build:types && node scripts/postgres-signal-source-trust-apply.mjs",
    "postgres:signal-retailer-qualification-apply": "npm run build:types && node scripts/postgres-signal-retailer-qualification-apply.mjs",
    "postgres:signal-mission-policy-apply": "npm run build:types && node scripts/postgres-signal-mission-policy-apply.mjs",
    "postgres:signal-source-status-apply": "npm run build:types && node scripts/postgres-signal-source-status-apply.mjs",
    "postgres:signal-source-sync-apply": "npm run build:types && node scripts/postgres-signal-source-sync-apply.mjs",
    "postgres:signal-reservation-lifecycle-apply": "npm run build:types && node scripts/postgres-signal-reservation-lifecycle-apply.mjs",
    "postgres:signal-catalog-import-apply": "npm run build:types && node scripts/postgres-signal-catalog-import-apply.mjs",
    "postgres:signal-source-provisioning-apply": "npm run build:types && node scripts/postgres-signal-source-provisioning-apply.mjs",
    "postgres:signal-attribution-policy-apply": "npm run build:types && node scripts/postgres-signal-attribution-policy-apply.mjs",
    "postgres:signal-evaluation-composition": "npm run build:types && node scripts/postgres-signal-evaluation-composition.mjs",
    "postgres:signal-attribution-receipt-apply": "npm run build:types && node scripts/postgres-signal-attribution-receipt-apply.mjs",
    "postgres:signal-job-lifecycle-apply": "npm run build:types && node scripts/postgres-signal-job-lifecycle-apply.mjs",
    "postgres:signal-evaluation-repository-composition": "npm run build:types && node scripts/postgres-signal-evaluation-repository-composition.mjs",
    "postgres:signal-ingress-enqueue-apply": "npm run build:types && node scripts/postgres-signal-ingress-enqueue-apply.mjs",
    "postgres:signal-dead-letter-reset-apply": "npm run build:types && node scripts/postgres-signal-dead-letter-reset-apply.mjs",
    "postgres:signal-ingress-composition": "npm run build:types && node scripts/postgres-signal-ingress-composition.mjs",
    "postgres:signal-notification-ensure-apply": "npm run build:types && node scripts/postgres-signal-notification-ensure-apply.mjs",
    "postgres:signal-handler-composition": "npm run build:types && node scripts/postgres-signal-handler-composition.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "16.14.0-beta.17",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
