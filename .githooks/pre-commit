#!/usr/bin/env sh
# Refuses a commit from a tree that does not type-check, carries a stale
# extension bundle or token file, an invalid selector pack, or a new bare
# repository throw (PLAT-10). Enable once per clone:
#   git config core.hooksPath .githooks
# Bypass deliberately with `git commit --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"
if ! npm run --silent check; then
  echo "pre-commit: npm run check failed; fix it or commit with --no-verify." >&2
  exit 1
fi
